# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database settings
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# TMDB API settings
TMDB_API_KEY=your-tmdb-api-key
TMDB_READ_ACCESS_TOKEN=your-tmdb-read-access-token

# CORS settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:3000,https://localhost:5173

# Security settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Cache settings
CACHE_TTL_TRENDING=3600
CACHE_TTL_DISCOVER=3600
CACHE_TTL_SEARCH=3600
CACHE_TTL_DETAILS=86400
CACHE_TTL_GENRES=604800
CACHE_TTL_PLATFORMS=604800

# JWT settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30
ROTATE_REFRESH_TOKENS=False

# Password validation
MIN_PASSWORD_LENGTH=8

# Internationalization
TIME_ZONE=UTC

# API pagination
API_PAGE_SIZE=20
